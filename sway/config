for_window [title="Overlay_CS2"] {
    floating enable
    border none
    sticky enable
}

for_window [class="ghidra-Ghidra"] {
    opacity 0.85
}

for_window [app_id="com.hex_rays.IDA.free._9_3"] {
    opacity 0.85
}
